.emergency-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; background-color: #ff4d4f; padding: 40rpx; box-sizing: border-box; }
.icon { font-size: 120rpx; margin-bottom: 30rpx; }
.title { font-size: 48rpx; color: #fff; font-weight: bold; margin-bottom: 20rpx; }
.desc { font-size: 30rpx; color: #fff; text-align: center; line-height: 1.6; margin-bottom: 80rpx; }
.call-btn { width: 80% !important; height: 100rpx; line-height: 100rpx; font-size: 36rpx; font-weight: bold; border-radius: 50rpx; background-color: #fff; color: #ff4d4f; margin-bottom: 40rpx; }
.back-btn { color: #fff; font-size: 28rpx; text-decoration: underline; }
/* pages/input/input.wxss */
.container {
  padding: 30rpx;
  background-color: #f5f6f8;
  min-height: 100vh;
  box-sizing: border-box; 
  width: 100%;
  overflow-x: hidden; /* 防止横向滚动 */
}
.section-title { font-size: 32rpx; font-weight: bold; color: #333; margin: 30rpx 0 20rpx 10rpx; }
.tags-group { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 40rpx; }
.tag { background: #fff; border: 2rpx solid #ddd; padding: 16rpx 32rpx; border-radius: 40rpx; font-size: 28rpx; color: #555; }
.tag.active { background: #e6f0ff; border-color: #0066cc; color: #0066cc; font-weight: bold; }
.extra-input { background: #fff; width: 100%; height: 160rpx; padding: 20rpx; border-radius: 16rpx; box-sizing: border-box; font-size: 28rpx; margin-bottom: 60rpx; }
.submit-btn { width: 100% !important; border-radius: 40rpx; background-color: #0066cc; }